# API key stays on the server. Never commit a real key or place it in the APK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set NUTRIAI_ENV=production on any network-accessible deployment.
# In production, API_ACCESS_TOKEN is mandatory; protected routes fail closed if absent.
NUTRIAI_ENV=production
API_ACCESS_TOKEN=replace-with-a-long-random-secret
